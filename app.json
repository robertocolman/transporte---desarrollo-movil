{
  "expo": {
    "name": "Transporte Paraná",
    "slug": "paranaunergrupo9",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "transporteparana",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121b28"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Transporte Paraná necesita tu ubicación para indicarte las paradas más cercanas y guiarte con la brújula.",
        "NSCameraUsageDescription": "Transporte Paraná utiliza la cámara para escanear el código QR de las paradas."
      }
    },
    "android": {
      "package": "com.uner.transporteparana",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121b28"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForAndroidManifestConfig"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications",
      "@react-native-vector-icons/ionicons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Transporte Paraná necesita tu ubicación para mostrarte las paradas más cercanas."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite acceder a la cámara para escanear el código QR de las paradas."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f3ce7dbc-cf30-422b-aba0-8a4c592b0b87"
      }
    }
  }
}
